-- ฟังก์ชันตรวจสอบบทบาท MM2
local function getMM2Role(p)
    if not p then return "Innocent", espColor end
    
    local backpack = p:FindFirstChild("Backpack")
    local char = p.Character
    
    if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
        return "Murderer", Color3.fromRGB(255, 0, 0)
    elseif (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then
        return "Sheriff", Color3.fromRGB(0, 100, 255)
    end
    
    return "Innocent", espColor
end

local function applyESP(p)
    if p == LocalPlayer then return end
    
    local function setupCharacter(char)
        if not char then return end
        
        -- 1. Highlight 3D
        local highlight = char:FindFirstChild("FullBodyESP")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "FullBodyESP"
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = char
        end
        
        -- 2. BillboardGui
        local nameGui = char:FindFirstChild("ESPNameGui")
        local nameLabel
        if not nameGui then
            nameGui = Instance.new("BillboardGui")
            nameGui.Name = "ESPNameGui"
            nameGui.AlwaysOnTop = true
            nameGui.Size = UDim2.new(0, 200, 0, 50)
            nameGui.StudsOffset = Vector3.new(0, 2.5, 0)
            
            nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 1, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = p.Name
            nameLabel.Font = Enum.Font.SourceSansBold
            nameLabel.TextSize = 14
            nameLabel.TextStrokeTransparency = 0 
            nameLabel.Parent = nameGui
            nameGui.Parent = char
        else
            nameLabel = nameGui:FindFirstChildOfClass("TextLabel")
        end
        
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not char:IsDescendantOf(workspace) or not highlight.Parent or not nameGui.Parent then
                conn:Disconnect()
                return
            end
            
            if not espEnabled then
                highlight.Enabled = false
                nameGui.Enabled = false
                return
            end
            
            local currentValidColor = espColor
            local roleText = ""
            
            -- === [แก้ไขบั๊ก] นำส่วนตรวจสอบสวิตช์ noclipEnabled ที่ทับซ้อนและดึงค่า CanCollide ผิดพลาดออกไปเรียบร้อยแล้ว ===
            if mm2RoleCheck then
                local role, roleColor = getMM2Role(p)
                currentValidColor = roleColor
                if role ~= "Innocent" then
                    roleText = " [" .. role .. "]"
                end
            elseif teamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then
                currentValidColor = p.TeamColor.Color
            end
            
            highlight.FillColor = currentValidColor
            highlight.OutlineColor = currentValidColor
            highlight.Enabled = true
            
            if showNames then
                nameLabel.Text = p.Name .. roleText
                nameLabel.TextColor3 = currentValidColor
                nameGui.Enabled = true
            else
                nameGui.Enabled = false
            end
        end)
    end
    
    if p.Character then setupCharacter(p.Character) end
    p.CharacterAdded:Connect(setupCharacter)
end

for _, p in pairs(Players:GetPlayers()) do applyESP(p) end
Players.PlayerAdded:Connect(applyESP)

