local espObjects = {} -- [player] = {box, name, tracer, dist}

local function createDrawings(p)
    if espObjects[p] then return end
    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Filled = false
    box.Transparency = 1

    local nameTag = Drawing.new("Text")
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true

    local tracer = Drawing.new("Line")
    tracer.Thickness = 1
    tracer.Transparency = 1

    local distText = Drawing.new("Text")
    distText.Size = 12
    distText.Center = true
    distText.Outline = true

    espObjects[p] = {
        box = box,
        name = nameTag,
        tracer = tracer,
        dist = distText,
    }
end

local function removeDrawings(p)
    local o = espObjects[p]
    if not o then return end
    for _, d in pairs(o) do
        if d and d.Remove then
            pcall(function() d:Remove() end)
        end
    end
    espObjects[p] = nil
end

Players.PlayerRemoving:Connect(function(p) removeDrawings(p) end)
Players.PlayerAdded:Connect(function(p) -- prepare when player joins
    createDrawings(p)
end)

-- initialize existing players
for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createDrawings(p) end
end

RunService.RenderStepped:Connect(function()
    if not Camera then Camera = workspace.CurrentCamera end
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then
            -- hide local player's drawings if any
            if espObjects[p] then
                local o = espObjects[p]
                for _, d in pairs(o) do if d then d.Visible = false end end
            end
            continue
        end

        local char = p.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        if not char or not humanoid or humanoid.Health <= 0 or not root then
            removeDrawings(p)
            continue
        end

        createDrawings(p)
        local o = espObjects[p]
        if not o then continue end

        if not espEnabled then
            for _, d in pairs(o) do if d then d.Visible = false end end
            continue
        end

        local head = char:FindFirstChild("Head")
        local headPos = head and head.Position or (root.Position + Vector3.new(0, 1.5, 0))
        local rootPos = root.Position

        local headScreen, headOnScreen = Camera:WorldToViewportPoint(headPos + Vector3.new(0, 0.3, 0))
        local rootScreen, rootOnScreen = Camera:WorldToViewportPoint(rootPos)
        local onScreen = headOnScreen or rootOnScreen

        local color = espColor
        if teamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then
            color = p.TeamColor.Color
        end

        if not onScreen then
            for _, d in pairs(o) do if d then d.Visible = false end end
            continue
        end

        -- compute box size from head/root screen positions
        local height = math.abs(headScreen.Y - rootScreen.Y)
        if height < 6 then height = 6 end
        local width = math.clamp(height / 2, 6, 300) * sizeMultiplier

        -- Box
        o.box.Color = color
        o.box.Size = Vector2.new(width, height)
        o.box.Position = Vector2.new(headScreen.X - width/2, headScreen.Y - height)
        o.box.Visible = showBoxes

        -- Name
        local distance = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - rootPos).Magnitude) or 0)
        o.name.Text = (showNames and (p.Name .. (showDistance and (" ["..distance.."m]") or ""))) or ""
        o.name.Position = Vector2.new(headScreen.X, headScreen.Y - (height + 12))
        o.name.Color = color
        o.name.Visible = showNames

        -- Distance (separate, below name if needed)
        o.dist.Text = (showDistance and tostring(distance .. "m")) or ""
        o.dist.Position = Vector2.new(headScreen.X, headScreen.Y - (height + 2))
        o.dist.Color = color
        o.dist.Visible = false -- not used separately since distance appended to name above

        -- Tracer (from bottom-center of screen to root)
        o.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        o.tracer.To = Vector2.new(rootScreen.X, rootScreen.Y)
        o.tracer.Color = color
        o.tracer.Visible = showTracers
    end
end)
